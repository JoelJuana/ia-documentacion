{
  "name": "app-documentacion-ia",
  "type": "module",
  "version": "0.1.0",
  "scripts": {
    "dev": "node scripts/sync-catalog.js && astro dev",
    "sync:watch": "node scripts/sync-catalog.js --watch",
    "start": "node scripts/sync-catalog.js && astro dev",
    "audit": "node scripts/audit-portal.js",
    "index:rag": "node scripts/index-rag.js",
    "index:rag:force": "node scripts/index-rag.js --force",
    "build": "node scripts/sync-catalog.js && node scripts/audit-portal.js && astro build && node scripts/generate-sitemap.js && node scripts/index-rag.js",
    "deploy": "npm run build && node scripts/deploy-portal.js",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/starlight": "^0.28.6",
    "astro": "^4.16.10",
    "sharp": "^0.33.5"
  }
}
